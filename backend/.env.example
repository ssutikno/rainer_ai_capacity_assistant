PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
RESULT_TTL_HOURS=168
RESUME_TTL_HOURS=72
ADMIN_API_KEY=replace-with-a-long-random-secret
DATA_FILE=./data/rainer.json
EMAIL_MODE=console
FREE_EMAIL_POLICY=warn
RATE_LIMIT_PER_MINUTE=100
AI_REQUIRED=true
# URL dan API key tidak disimpan di file ini. Backend membacanya dari
# system environment variable: ai_host_url dan ai_api_key.
AI_MODEL=your-structured-output-model
AI_TIMEOUT_MS=120000
